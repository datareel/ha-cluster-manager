# Cluster manaager sub-interface template file
# LEGACY: network-scripts only (RHEL 6/7 without NetworkManager).
# On RHEL 8 and later use the NetworkManager resource scripts instead
# (/etc/drcm/resources/ipv4addr_nmcli.sh), which need no template.
# RHEL/CENTOS location: /etc/sysconfig/network-scripts
# Install as ifcfg-eth0:3 (stored as ifcfg-eth0_3 because Windows does not allow ':' in file names)
# NOTE: IPADDR and PREFIX/NETMASK will be set by DRCM process
DEVICE=eth0:3
BOOTPROTO=none
ONBOOT=yes

