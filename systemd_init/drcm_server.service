[Unit]
Description=DataReel cluster manager (DRCM)
Documentation=man:drcm_server(8)
Wants=network-online.target
After=network-online.target remote-fs.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=CFGFILE=/etc/drcm/cm.cfg
EnvironmentFile=-/etc/sysconfig/drcm_server
ExecStart=/usr/sbin/drcm_server --config-file=${CFGFILE} $ARGS
# DRCM stops its own resources on SIGTERM. Only signal the server
# process, so resource stop scripts can run and resources kept with
# keep_services, keep_applications or keep_filesystems stay up.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=180
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
