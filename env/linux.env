# --------------------------------------------------------------- 
# Makefile Contents: make settings to build datareel library
# C/C++ Compiler Used: GUN, Intel, Cray
# --------------------------------------------------------------- 
# Define file extensions and path variables
OBJ_EXT = .o
EXE_EXT = 
LIB_EXT = .a
DLIB_EXT = .so
PATHSEP = /
SHAREDLIB_VERSION = 6.4
SHAREDLIB_EXT = $(DLIB_EXT).$(SHAREDLIB_VERSION)

# Installation directory for the library files
LIB_INSTALL_DIR = ../lib

# Setup include paths
ADD_INC_PATHS = -I$(GCODE_LIB_DIR)$(PATHSEP)include

ifeq ($(FINAL),1)
     	DEBUG_DEFMACS = -D__NO_DEBUG_OPTIONS__
else
	DEBUG_DEFMACS = -D__DEBUG__
endif

# Our NODETYPE and BUILD must be set in our ENV
BUILD := $(BUILD)
NODETYPE := $(NODETYPE)
USE_IOBUF := $(USE_IOBUF)

ifeq ($(BUILD),cray)
     COMPILER_DEFMACS = -DCRAYCE
     LIBCOMPILE_FLAGS = -fPIC 
else ifeq ($(BUILD),intel)
     COMPILER_DEFMACS = -DINTEL
     LIBCOMPILE_FLAGS = -fPIC
else ifeq ($(BUILD),gnu)
     COMPILER_DEFMACS = -DGNU
     LIBCOMPILE_FLAGS = -fPIC
else
     COMPILER_DEFMACS = -DGNU
     BUILD = gnu
     COMPILER = gnu
     LIBCOMPILE_FLAGS = -fPIC
endif

ifeq ($(NODETYPE),COMPUTE)
ifeq ($(USE_IOBUF),YES)
      COMPILER_DEFMACS := $(COMPILER_DEFMACS) -DUSE_IOBUF_MACROS -D_USE_DIRECT_IO_ 
endif
endif

ifeq ($(NODETYPE),LOGIN)
ifeq ($(USE_IOBUF),YES)
      COMPILER_DEFMACS := $(COMPILER_DEFMACS) -DUSE_IOBUF_MACROS -D_USE_DIRECT_IO_  	
endif
endif

# Define large file settings, files over 2.1GB
ifeq ($(LARGEFILES),1)
	LARGEFILE_DEFMACS = -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES -D__64_BIT_DATABASE_ENGINE__ -D__ENABLE_64_BIT_INTEGERS__
else
	LARGEFILE_DEFMACS = 
endif

TYPES_DEFMACS = -D__USE_NATIVE_INT_TYPES__ -D__USE_NATIVE_FLOAT_TYPES__ 
ANSI_DEFMACS = -D__USE_ANSI_CPP__
CPP_DEFMACS = -D__USE_CPP_IOSTREAM__ #-D__CPP_EXCEPTIONS__
IO_DEFMACS = -D__USE_SIGNAL_IO__
THREAD_DEFMACS = -D__REENTRANT__ -D_REENTRANT
POSIX_DEFMACS = -D__POSIX__ -D_POSIX_PTHREAD_SEMANTICS
UNICODE_DEMACS = -D__HAS_UNICODE__

# Setup define macros
DEFMACS = $(COMPILER_DEFMACS) -D__UNIX__ -D__LINUX__ -D__X86__ \
$(LARGEFILE_DEFMACS) $(TYPES_DEFMACS) $(ANSI_DEFMACS) $(CPP_DEFMACS) \
$(DEBUG_DEFMACS) $(IO_DEFMACS) $(UNICODE_DEMACS) \
$(THREAD_DEFMACS) $(POSIX_DEFMACS)

# Define macros for compiler and linker
LINKER = ld
LIBUTIL = ar
RANLIB_UTIL = ranlib
SHARED_LIBUTIL = $(CC) -shared
LN_S = ln -s
LIBUTIL_FLAGS = ruv
SHAREDLIBUTIL_FLAGS =

# Define compiler and linker flags macros
DEBUG_FLAGS = $(CXXFLAGS) $(ADD_INC_PATHS) $(DEFMACS)
RELEASE_FLAGS = $(CXXFLAGS) $(ADD_INC_PATHS) $(DEFMACS)

ifeq ($(FINAL),1)
	COMPILE_FLAGS = $(RELEASE_FLAGS)
else
	COMPILE_FLAGS = $(DEBUG_FLAGS)
endif

COMPILE_ONLY = -c
OUTPUT = -o

# Set link libraries here.
# OpenSSL (libssl/libcrypto) provides TLS for TCP mode and HMAC-SHA256
# for the authenticated message frame used by both transports.
#
# By default the system OpenSSL is used (RHEL 9/10: OpenSSL 3.5). To build
# against another OpenSSL, such as OpenSSL 3.5 on RHEL 8, set ONE of:
#   OPENSSL_PC=openssl3          pkg-config name (EPEL openssl3 on RHEL 8);
#                                the binary gets an rpath to its libdir
#   OPENSSL_PREFIX=/opt/ossl35   an install prefix (include/ and lib64/);
#                                add OPENSSL_STATIC=1 to link it statically
# for example: make OPENSSL_PC=openssl3
OPENSSL_PC ?=
OPENSSL_PREFIX ?=
OPENSSL_STATIC ?= 0
ifneq ($(OPENSSL_PC),)
  OPENSSL_CFLAGS := $(shell pkg-config --cflags $(OPENSSL_PC))
  OPENSSL_LIBDIR := $(shell pkg-config --variable=libdir $(OPENSSL_PC))
  OPENSSL_LIBS := $(shell pkg-config --libs $(OPENSSL_PC)) -Wl,-rpath,$(OPENSSL_LIBDIR)
else ifneq ($(OPENSSL_PREFIX),)
  OPENSSL_LIBDIR := $(firstword $(wildcard $(OPENSSL_PREFIX)/lib64 $(OPENSSL_PREFIX)/lib))
  OPENSSL_CFLAGS := -I$(OPENSSL_PREFIX)/include
  ifeq ($(OPENSSL_STATIC),1)
    OPENSSL_LIBS := $(OPENSSL_LIBDIR)/libssl.a $(OPENSSL_LIBDIR)/libcrypto.a -ldl
  else
    OPENSSL_LIBS := -L$(OPENSSL_LIBDIR) -lssl -lcrypto -Wl,-rpath,$(OPENSSL_LIBDIR)
  endif
else
  OPENSSL_CFLAGS :=
  OPENSSL_LIBS := -lssl -lcrypto
endif
ADD_INC_PATHS += $(OPENSSL_CFLAGS)
LINK_LIBRARIES = -lpthread $(OPENSSL_LIBS)

LINKER_FLAGS =

# --------------------------------------------------------------- 
