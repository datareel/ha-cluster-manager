#!/bin/bash
# Test only: rootless podman maps just uid 0, so the real su fails with
# "cannot set groups". DRCM runs applications as
# su [-g group] -c 'command' - user; every test app runs as root, so
# run the command directly.
while [ $# -gt 0 ]; do
    case "$1" in
	-c) cmd="$2"; shift 2 ;;
	-g) shift 2 ;;
	*) shift ;;
    esac
done
exec /bin/bash -c "$cmd"
